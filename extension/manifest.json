{
  "manifest_version": 3,
  "name": "Tavvy — Tabs Group",
  "version": "0.2.16",
  "description": "Tab groups and workspaces for Firefox",
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: resource: https: http:; connect-src 'none'; upgrade-insecure-requests"
  },
  "icons": { "32": "icon.svg", "48": "icon.svg", "96": "icon.svg" },
  "permissions": [
    "tabs",
    "menus",
    "contextualIdentities",
    "tabHide",
    "storage",
    "sessions",
    "alarms",
    "downloads"
  ],
  "optional_permissions": ["cookies"],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "action": {
    "default_icon": "icon.svg",
    "default_title": "Tavvy",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tavvy@local.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
